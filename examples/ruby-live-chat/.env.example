# Copy to `.env` (git-ignored) and fill in.
#
# `ANIMATED_WAFFLE_PUBLIC_*` values are browser configuration: the Vite config
# exposes exactly that prefix through `import.meta.env`. The API key below is
# named outside it on purpose, so it stays on the server and never reaches the
# bundle.

# A published Agent whose Avatar is Ruby.
ANIMATED_WAFFLE_PUBLIC_AGENT_ID=00000000-0000-4000-8000-000000000000

# Permanent workspace API key. Server-side only.
ANIMATED_WAFFLE_API_KEY=awp_replace_me

# Optional. Production is the default for both the browser SDK and the token
# endpoint. Point both at a non-production API to develop against it:
#   ANIMATED_WAFFLE_PUBLIC_API_ORIGIN=https://animated-waffle-dev.narya.ai
#   ANIMATED_WAFFLE_PUBLIC_API_ORIGIN=http://127.0.0.1:8789
# ANIMATED_WAFFLE_PUBLIC_API_ORIGIN=

# Fast iteration against the dev environment: put dev credentials in
# `.env.dev.local` (git-ignored) with the same three variables, and run
# `pnpm dev:dev` — vite loads it on top of `.env` and both the browser and
# the token endpoint talk to https://animated-waffle-dev.narya.ai.
